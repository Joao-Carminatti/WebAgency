# --- Envio de leads por e-mail (Resend) ---
RESEND_API_KEY=
# Com o remetente de teste, use o MESMO e-mail com o qual criou a conta no Resend
LEAD_TO_EMAIL=
# Opcional: remetente próprio (exige domínio verificado no Resend). Padrão: Site <onboarding@resend.dev>
LEAD_FROM_EMAIL=
# --- Opcional: webhook (n8n/CRM). Pode ser usado junto com o e-mail ---
LEAD_WEBHOOK_URL=
# URL final do site (sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=
# Analytics (opcionais; nada carrega se vazio e só após consentimento)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=